{
  "manifest_version": 3,
  "name": "PDF-Anhänge für Edge",
  "version": "1.1.1",
  "description": "Zeigt eingebettete PDF-Anhänge neben dem Edge-Viewer und öffnet sie mit der zugeordneten Windows-Anwendung.",
  "minimum_chrome_version": "124",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "webRequest",
    "downloads",
    "downloads.open"
  ],
  "host_permissions": [
    "file:///*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PDF-Anhänge anzeigen",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "PDF-Anhänge anzeigen"
    }
  },
  "key": "",
  "optional_permissions": [
    "nativeMessaging"
  ]
}
